{
  "name": "schatzies-serverless-backend",
  "version": "1.0.0",
  "description": "Serverless Express app for AWS Lambda",
  "main": "handler.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "cross-env NODE_ENV=development nodemon src/server.js",
    "offline": "serverless offline start",
    "format": "prettier --write \"src/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.js\""
  },
  "keywords": [
    "serverless",
    "aws",
    "lambda",
    "express"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1038.0",
    "@aws-sdk/client-s3": "^3.1038.0",
    "@aws-sdk/lib-storage": "^3.1038.0",
    "@aws-sdk/s3-request-presigner": "^3.1038.0",
    "@aws-sdk/util-dynamodb": "^3.996.2",
    "axios": "^1.6.2",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.3.1",
    "helmet": "^8.1.0",
    "joi": "^17.10.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.4",
    "qrcode": "^1.5.4",
    "serverless-http": "^3.2.0",
    "sharp": "^0.34.5",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-dist": "^5.0.0",
    "swagger-ui-express": "^5.0.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.8.1",
    "serverless": "^4.33.0",
    "serverless-offline": "^14.5.0"
  }
}